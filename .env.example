# Kopiraj u .env i popuni. .env je u .gitignore i nikad se ne commita.

# PostgreSQL veza. Baza mora postojati prije prvog pokretanja:
#   createdb -U postgres licita
DATABASE_URL=postgresql://postgres:LOZINKA@localhost:5432/licita

# Domena na kojoj se objavljuje (koristi se za canonical, sitemap, JSON-LD).
LICITA_SITE_URL=https://licita.hr

# Sigurnosne granice — pipeline staje ako izvor vrati sumnjivo malo podataka.
LICITA_MIN_BYTES=1000000
LICITA_MIN_ROWS=500
LICITA_HTTP_TIMEOUT=180
