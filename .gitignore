!data/*.csv

# generirane stranice
public/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# alati
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
Thumbs.db

# wrangler lokalno stanje
.wrangler/
